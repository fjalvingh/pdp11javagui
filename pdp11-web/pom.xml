<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>to.etc.pdp11</groupId>
        <artifactId>java11gui</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pdp11-web</artifactId>
    <packaging>war</packaging>

    <name>pdp11-web</name>
    <description>
        Minicomputer tools on the web, built on DomUI: the microcode browsers first, and
        disassembling images and small assembly tasks later. Uses pdp11-common and nothing else
        of this project - there is no machine at the other end of a web page.
    </description>

    <dependencies>
        <dependency>
            <groupId>to.etc.pdp11</groupId>
            <artifactId>pdp11-common</artifactId>
        </dependency>

        <!--
            DomUI is not on Maven Central. It is the domui/ submodule, installed into the local
            repository by tools/build-domui.sh before this reactor is built.
        -->
        <dependency>
            <groupId>to.etc.domui</groupId>
            <artifactId>to.etc.domui</artifactId>
        </dependency>
        <!-- DomUI will not start without an icon set; this one registers itself on the classpath. -->
        <dependency>
            <groupId>to.etc.domui</groupId>
            <artifactId>fontawesome6free</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.servlet</groupId>
            <artifactId>jakarta.servlet-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>pdp11-web</finalName>

        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>web-uses-common-only</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <!--
                                    The web application shares pdp11-common with the desktop and
                                    nothing more. pdp11-core would bring the console protocols and
                                    the serial port; pdp11-ui and pdp11-app bring Swing.
                                -->
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>to.etc.pdp11:pdp11-core</exclude>
                                        <exclude>to.etc.pdp11:pdp11-ui</exclude>
                                        <exclude>to.etc.pdp11:pdp11-app</exclude>
                                        <exclude>com.fazecast:jSerialComm</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <!--
                ./mvnw -pl pdp11-web -am install -DskipTests, then
                ./mvnw -pl pdp11-web jetty:run and open http://localhost:8080/
            -->
            <plugin>
                <groupId>org.eclipse.jetty</groupId>
                <artifactId>jetty-maven-plugin</artifactId>
                <configuration>
                    <httpConnector>
                        <port>${web.http.port}</port>
                    </httpConnector>
                    <webApp>
                        <contextPath>/</contextPath>
                    </webApp>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
