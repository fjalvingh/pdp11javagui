         002430    040     127     111  
         002433    116     056     040  
         002436    040     127     105  
         002441    114     114     040  
         002444    120     114     101  
         002447    131     105     104  
         002452    041                  
     293 002453    015     012     000  	.BYTE	15,12,0
     294 002456    015     012          MSGIWN:	.BYTE	15,12
