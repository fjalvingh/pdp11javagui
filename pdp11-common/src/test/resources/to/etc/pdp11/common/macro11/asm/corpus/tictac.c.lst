       1                                	.TITLE	TICTAC - TIC-TAC-TOE FOR A BARE PDP-11
       2                                ;
       3                                ; Tic-tac-toe on the console terminal, with no operating system.
       4                                ; You are X and move first; the machine is O.
       5                                ;
       6                                ; Runs on anything from an 11/05 up: it uses only the basic instruction
       7                                ; set (no SOB, XOR, SXT, MUL or DIV) and polls the console DL11 at
       8                                ; 177560 directly, with interrupts left off.
       9                                ;
      10                                ; Load it, then start at 1000. On an M9312 console:  L 1000  then  S
      11                                ; It plays game after game; stop it with the HALT switch.
      12                                ;
      13                                ; The machine's strategy, in order: win if it can; block a line you are
      14                                ; about to complete; otherwise take the centre, then a corner, then a side.
      15                                ; That is enough that it never loses to a careless player - and you can
      16                                ; still beat it with a fork.
      17                                
      18 177560                         TKS	= 177560		; console keyboard status: bit 7 = character ready
      19 177562                         TKB	= 177562		; console keyboard buffer
      20 177564                         TPS	= 177564		; console printer status: bit 7 = ready to print
      21 177566                         TPB	= 177566		; console printer buffer
      22                                
      23 000040                         SPACE	= 40			; an empty square
      24                                
      25                                	.ASECT
      26 001000                         	.=1000
      27                                
      28 001000 012706  001000          START:	MOV	#START,SP	; stack grows down from 1000
      29                                
      30                                ; ---------------------------------------------------------------------
      31                                ; One game
      32                                ; ---------------------------------------------------------------------
      33                                
      34 001004 012700  002100          NEWGAM:	MOV	#BOARD,R0	; empty every square
      35 001010 012701  000011          	MOV	#9.,R1
      36 001014 112720  000040          1$:	MOVB	#SPACE,(R0)+
      37 001020 005301                  	DEC	R1
      38 001022 001374                  	BNE	1$
      39 001024 012700  002111          	MOV	#MSGHDR,R0
      40 001030 004767  002014'         	JSR	PC,PUTS
      41                                
      42 001034 004767  001570'         TURN:	JSR	PC,SHOW
      43                                
      44                                ; --- Your move -------------------------------------------------------
      45                                
      46 001040 012700  002256          ASK:	MOV	#MSGMOV,R0
      47 001044 004767  002014'         	JSR	PC,PUTS
      48 001050 004767  001746'         	JSR	PC,GETC		; R0 = the key, already echoed
      49 001054 120027  000061          	CMPB	R0,#'1
      50 001060 103463                  	BLO	BADKEY
      51 001062 120027  000071          	CMPB	R0,#'9
      52 001066 101060                  	BHI	BADKEY
      53 001070 162700  000061          	SUB	#'1,R0		; '1'..'9' -> square 0..8
      54 001074 126027  002100  000040  	CMPB	BOARD(R0),#SPACE
      55 001102 001057                  	BNE	TAKEN
      56 001104 112760  000130  002100  	MOVB	#'X,BOARD(R0)
      57 001112 004767  001772'         	JSR	PC,CRLF
      58                                
      59 001116 012702  000130          	MOV	#'X,R2
      60 001122 004767  001456'         	JSR	PC,CHKWIN
      61 001126 005700                  	TST	R0
      62 001130 001051                  	BNE	YOUWIN
      63 001132 004767  001534'         	JSR	PC,FULL
      64 001136 005700                  	TST	R0
      65 001140 001053                  	BNE	DRAW
      66                                
      67                                ; --- The machine's move ----------------------------------------------
      68                                
      69 001142 004767  001334'         	JSR	PC,THINK	; R1 = the square it picks
      70 001146 112761  000117  002100  	MOVB	#'O,BOARD(R1)
      71 001154 012700  002375          	MOV	#MSGME,R0
      72 001160 004767  002014'         	JSR	PC,PUTS
      73 001164 010100                  	MOV	R1,R0
      74 001166 062700  000061          	ADD	#'1,R0
      75 001172 004767  001732'         	JSR	PC,PUTC
      76 001176 004767  001772'         	JSR	PC,CRLF
      77                                
      78 001202 012702  000117          	MOV	#'O,R2
      79 001206 004767  001456'         	JSR	PC,CHKWIN
      80 001212 005700                  	TST	R0
      81 001214 001022                  	BNE	IWIN
      82 001216 004767  001534'         	JSR	PC,FULL
      83 001222 005700                  	TST	R0
      84 001224 001021                  	BNE	DRAW
      85 001226 000702                  	BR	TURN
      86                                
      87 001230 012700  002302          BADKEY:	MOV	#MSGBAD,R0
      88 001234 004767  002014'         	JSR	PC,PUTS
      89 001240 000677                  	BR	ASK
      90 001242 012700  002345          TAKEN:	MOV	#MSGTKN,R0
      91 001246 004767  002014'         	JSR	PC,PUTS
      92 001252 000672                  	BR	ASK
      93                                
      94                                ; --- The end of a game -----------------------------------------------
      95                                
      96 001254 012700  002423          YOUWIN:	MOV	#MSGYOU,R0
      97 001260 000405                  	BR	OVER
      98 001262 012700  002456          IWIN:	MOV	#MSGIWN,R0
      99 001266 000402                  	BR	OVER
     100 001270 012700  002471          DRAW:	MOV	#MSGDRW,R0
     101 001274 010046                  OVER:	MOV	R0,-(SP)
     102 001276 004767  001570'         	JSR	PC,SHOW
     103 001302 012600                  	MOV	(SP)+,R0
     104 001304 004767  002014'         	JSR	PC,PUTS
     105 001310 012700  002505          	MOV	#MSGAGN,R0
     106 001314 004767  002014'         	JSR	PC,PUTS
     107 001320 004767  001746'         	JSR	PC,GETC
     108 001324 004767  001772'         	JSR	PC,CRLF
     109 001330 000167  001004'         	JMP	NEWGAM
     110                                
     111                                ; ---------------------------------------------------------------------
     112                                ; THINK - choose the machine's square.  Returns it in R1.
     113                                ; ---------------------------------------------------------------------
     114                                
     115 001334 012702  000117          THINK:	MOV	#'O,R2		; can O win right now?
     116 001340 004767  001404'         	JSR	PC,TRYALL
     117 001344 005701                  	TST	R1
     118 001346 100015                  	BPL	9$
     119 001350 012702  000130          	MOV	#'X,R2		; can X win next move? then block it
     120 001354 004767  001404'         	JSR	PC,TRYALL
     121 001360 005701                  	TST	R1
     122 001362 100007                  	BPL	9$
     123 001364 012703  002067          	MOV	#ORDER,R3	; otherwise the best free square
     124 001370 112301                  1$:	MOVB	(R3)+,R1
     125 001372 126127  002100  000040  	CMPB	BOARD(R1),#SPACE
     126 001400 001373                  	BNE	1$		; FULL said one is free, so this ends
     127 001402 000207                  9$:	RTS	PC
     128                                
     129                                ; TRYALL - is there a square where R2 completes a line?
     130                                ; Tries R2 in each empty square in turn and takes it back.
     131                                ; Returns the square in R1, or -1.
     132                                
     133 001404 005001                  TRYALL:	CLR	R1
     134 001406 126127  002100  000040  1$:	CMPB	BOARD(R1),#SPACE
     135 001414 001011                  	BNE	2$
     136 001416 110261  002100          	MOVB	R2,BOARD(R1)	; try it
     137 001422 004767  001456'         	JSR	PC,CHKWIN
     138 001426 112761  000040  002100  	MOVB	#SPACE,BOARD(R1) ; and take it back
     139 001434 005700                  	TST	R0
     140 001436 001006                  	BNE	9$
     141 001440 005201                  2$:	INC	R1
     142 001442 020127  000011          	CMP	R1,#9.
     143 001446 103757                  	BLO	1$
     144 001450 012701  177777          	MOV	#-1,R1
     145 001454 000207                  9$:	RTS	PC
     146                                
     147                                ; ---------------------------------------------------------------------
     148                                ; CHKWIN - does the mark in R2 hold a whole line?
     149                                ; Returns R0 = 1 if so, 0 if not.  Uses R3 and R4; R1 and R2 are kept.
     150                                ; ---------------------------------------------------------------------
     151                                
     152 001456 012703  002036          CHKWIN:	MOV	#LINES,R3
     153 001462 112304                  1$:	MOVB	(R3)+,R4	; first square of the line, or -1 at the end
     154 001464 100421                  	BMI	8$
     155 001466 126402  002100          	CMPB	BOARD(R4),R2
     156 001472 001013                  	BNE	3$
     157 001474 112304                  	MOVB	(R3)+,R4
     158 001476 126402  002100          	CMPB	BOARD(R4),R2
     159 001502 001010                  	BNE	4$
     160 001504 112304                  	MOVB	(R3)+,R4
     161 001506 126402  002100          	CMPB	BOARD(R4),R2
     162 001512 001363                  	BNE	1$
     163 001514 012700  000001          	MOV	#1,R0		; all three
     164 001520 000207                  	RTS	PC
     165 001522 005203                  3$:	INC	R3		; skip the rest of this line
     166 001524 005203                  4$:	INC	R3
     167 001526 000755                  	BR	1$
     168 001530 005000                  8$:	CLR	R0
     169 001532 000207                  	RTS	PC
     170                                
     171                                ; FULL - R0 = 1 if no square is free, 0 if one is.
     172                                
     173 001534 012700  002100          FULL:	MOV	#BOARD,R0
     174 001540 012704  000011          	MOV	#9.,R4
     175 001544 122027  000040          1$:	CMPB	(R0)+,#SPACE
     176 001550 001405                  	BEQ	2$
     177 001552 005304                  	DEC	R4
     178 001554 001373                  	BNE	1$
     179 001556 012700  000001          	MOV	#1,R0
     180 001562 000207                  	RTS	PC
     181 001564 005000                  2$:	CLR	R0
     182 001566 000207                  	RTS	PC
     183                                
     184                                ; ---------------------------------------------------------------------
     185                                ; SHOW - print the board.  A free square shows its own number, so you
     186                                ; can see what to type.
     187                                ;
     188                                ;	  X | 2 | O
     189                                ;	 ---+---+---
     190                                ;	  4 | X | 6
     191                                ; ---------------------------------------------------------------------
     192                                
     193 001570 010146                  SHOW:	MOV	R1,-(SP)
     194 001572 010246                  	MOV	R2,-(SP)
     195 001574 010346                  	MOV	R3,-(SP)
     196 001576 004767  001772'         	JSR	PC,CRLF
     197 001602 005001                  	CLR	R1		; square number
     198 001604 012703  000003          	MOV	#3,R3		; rows to go
     199 001610 012702  000003          1$:	MOV	#3,R2		; columns to go in this row
     200 001614 012700  000040          2$:	MOV	#SPACE,R0
     201 001620 004767  001732'         	JSR	PC,PUTC
     202 001624 116100  002100          	MOVB	BOARD(R1),R0
     203 001630 120027  000040          	CMPB	R0,#SPACE
     204 001634 001003                  	BNE	3$
     205 001636 010100                  	MOV	R1,R0		; free: show its number
     206 001640 062700  000061          	ADD	#'1,R0
     207 001644 004767  001732'         3$:	JSR	PC,PUTC
     208 001650 012700  000040          	MOV	#SPACE,R0
     209 001654 004767  001732'         	JSR	PC,PUTC
     210 001660 005201                  	INC	R1
     211 001662 005302                  	DEC	R2
     212 001664 001405                  	BEQ	4$
     213 001666 012700  000174          	MOV	#'|,R0
     214 001672 004767  001732'         	JSR	PC,PUTC
     215 001676 000746                  	BR	2$
     216 001700 004767  001772'         4$:	JSR	PC,CRLF
     217 001704 005303                  	DEC	R3
     218 001706 001405                  	BEQ	5$
     219 001710 012700  002405          	MOV	#MSGSEP,R0
     220 001714 004767  002014'         	JSR	PC,PUTS
     221 001720 000733                  	BR	1$
     222 001722 012603                  5$:	MOV	(SP)+,R3
     223 001724 012602                  	MOV	(SP)+,R2
     224 001726 012601                  	MOV	(SP)+,R1
     225 001730 000207                  	RTS	PC
     226                                
     227                                ; ---------------------------------------------------------------------
     228                                ; Console I/O, by polling
     229                                ; ---------------------------------------------------------------------
     230                                
     231                                ; PUTC - print the character in R0.
     232 001732 105737  177564          PUTC:	TSTB	@#TPS
     233 001736 100375                  	BPL	PUTC
     234 001740 110037  177566          	MOVB	R0,@#TPB
     235 001744 000207                  	RTS	PC
     236                                
     237                                ; GETC - wait for a key, echo it, return it in R0 without the parity bit.
     238 001746 105737  177560          GETC:	TSTB	@#TKS
     239 001752 100375                  	BPL	GETC
     240 001754 113700  177562          	MOVB	@#TKB,R0
     241 001760 042700  177600          	BIC	#177600,R0
     242 001764 004767  001732'         	JSR	PC,PUTC
     243 001770 000207                  	RTS	PC
     244                                
     245                                ; CRLF - start a new line.
     246 001772 012700  000015          CRLF:	MOV	#15,R0
     247 001776 004767  001732'         	JSR	PC,PUTC
     248 002002 012700  000012          	MOV	#12,R0
     249 002006 004767  001732'         	JSR	PC,PUTC
     250 002012 000207                  	RTS	PC
     251                                
     252                                ; PUTS - print the zero-terminated string at R0.  Keeps R1.
     253 002014 010146                  PUTS:	MOV	R1,-(SP)
     254 002016 010001                  	MOV	R0,R1
     255 002020 112100                  1$:	MOVB	(R1)+,R0
     256 002022 001403                  	BEQ	2$
     257 002024 004767  001732'         	JSR	PC,PUTC
     258 002030 000773                  	BR	1$
     259 002032 012601                  2$:	MOV	(SP)+,R1
     260 002034 000207                  	RTS	PC
     261                                
     262                                ; ---------------------------------------------------------------------
     263                                ; Data
     264                                ; ---------------------------------------------------------------------
     265                                
     266                                ; The eight lines, three squares each, ended by -1.
     267 002036    000     001     002  LINES:	.BYTE	0,1,2, 3,4,5, 6,7,8.		; rows
         002041    003     004     005  
         002044    006     007     010  
     268 002047    000     003     006  	.BYTE	0,3,6, 1,4,7, 2,5,8.		; columns
         002052    001     004     007  
         002055    002     005     010  
     269 002060    000     004     010  	.BYTE	0,4,8., 2,4,6			; diagonals
         002063    002     004     006  
     270 002066    377                  	.BYTE	-1
     271                                
     272                                ; Which free square to prefer: centre, corners, sides.
     273 002067    004     000     002  ORDER:	.BYTE	4, 0,2,6,8., 1,3,5,7
         002072    006     010     001  
         002075    003     005     007  
     274                                
     275 002100                         BOARD:	.BLKB	9.
     276                                
     277 002111    015     012          MSGHDR:	.BYTE	15,12
     278 002113    124     111     103  	.ASCII	/TIC-TAC-TOE.  YOU ARE X, I AM O.  YOU GO FIRST./
         002116    055     124     101  
         002121    103     055     124  
         002124    117     105     056  
         002127    040     040     131  
         002132    117     125     040  
         002135    101     122     105  
         002140    040     130     054  
         002143    040     111     040  
         002146    101     115     040  
         002151    117     056     040  
         002154    040     131     117  
         002157    125     040     107  
         002162    117     040     106  
         002165    111     122     123  
         002170    124     056          
     279 002172    015     012          	.BYTE	15,12
     280 002174    124     131     120  	.ASCII	/TYPE THE NUMBER OF A FREE SQUARE TO MOVE THERE./
         002177    105     040     124  
         002202    110     105     040  
         002205    116     125     115  
         002210    102     105     122  
         002213    040     117     106  
         002216    040     101     040  
         002221    106     122     105  
         002224    105     040     123  
         002227    121     125     101  
         002232    122     105     040  
         002235    124     117     040  
         002240    115     117     126  
         002243    105     040     124  
         002246    110     105     122  
         002251    105     056          
     281 002253    015     012     000  	.BYTE	15,12,0
     282 002256    015     012          MSGMOV:	.BYTE	15,12
     283 002260    131     117     125  	.ASCIZ	/YOUR MOVE (1-9): /
         002263    122     040     115  
         002266    117     126     105  
         002271    040     050     061  
         002274    055     071     051  
         002277    072     040     000  
     284 002302    015     012          MSGBAD:	.BYTE	15,12
     285 002304    120     114     105  	.ASCIZ	/PLEASE TYPE A DIGIT FROM 1 TO 9./
         002307    101     123     105  
         002312    040     124     131  
         002315    120     105     040  
         002320    101     040     104  
         002323    111     107     111  
         002326    124     040     106  
         002331    122     117     115  
         002334    040     061     040  
         002337    124     117     040  
         002342    071     056     000  
