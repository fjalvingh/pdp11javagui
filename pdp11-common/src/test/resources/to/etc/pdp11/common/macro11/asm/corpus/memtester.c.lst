     238                                ; ---------------------------------------------------------------------
     239                                ; The tests: start, next, name.  A start routine puts the first value
     240                                ; for the stretch beginning at 64-byte block R1 in R3; a next routine
     241                                ; turns R3 into the value for the word after.  Both use only R3.
     242                                ; ---------------------------------------------------------------------
     243                                
     244 001734 001774  002024  004272  TESTS:	.WORD	STADR,NXADR,TNADR
     245 001742 002034  002044  004302  	.WORD	STINV,NXINV,TNINV
     246 001750 002054  002066  004312  	.WORD	STZER,NXSAM,TNZER
     247 001756 002060  002066  004320  	.WORD	STONE,NXSAM,TNONE
     248 001764 002070  002076  004325  	.WORD	STCHK,NXFLP,TNCHK
     249 001772 000000                  	.WORD	0
     250                                
     251 001774 010103                  STADR:	MOV	R1,R3		; R1 * 32 modulo 177777: rotate left 5
     252 001776 006303                  	ASL	R3
     253 002000 005503                  	ADC	R3
     254 002002 006303                  	ASL	R3
     255 002004 005503                  	ADC	R3
     256 002006 006303                  	ASL	R3
     257 002010 005503                  	ADC	R3
     258 002012 006303                  	ASL	R3
     259 002014 005503                  	ADC	R3
     260 002016 006303                  	ASL	R3
     261 002020 005503                  	ADC	R3
     262 002022 000207                  	RTS	PC
     263 002024 062703  000001          NXADR:	ADD	#1,R3		; add 1 in one's complement
     264 002030 005503                  	ADC	R3
     265 002032 000207                  	RTS	PC
     266                                
     267 002034 004767  001774'         STINV:	JSR	PC,STADR
     268 002040 005103                  	COM	R3
     269 002042 000207                  	RTS	PC
     270 002044 162703  000001          NXINV:	SUB	#1,R3		; the complement of adding 1
     271 002050 005603                  	SBC	R3
     272 002052 000207                  	RTS	PC
     273                                
     274 002054 005003                  STZER:	CLR	R3
     275 002056 000207                  	RTS	PC
     276 002060 012703  177777          STONE:	MOV	#177777,R3
     277 002064 000207                  	RTS	PC
     278 002066 000207                  NXSAM:	RTS	PC
     279                                
     280 002070 012703  125252          STCHK:	MOV	#125252,R3	; every stretch is a whole number of
     281 002074 000207                  	RTS	PC		; words in pairs, so this lines up
     282 002076 005103                  NXFLP:	COM	R3
     283 002100 000207                  	RTS	PC
     284                                
     285                                ; ---------------------------------------------------------------------
     286                                ; WALK - call the routine at R5 for each stretch of the memory under
     287                                ; test, at most 8 KB: R1 = its first 64-byte block, R0 = the virtual
     288                                ; address it is at, R2 = its length in words.  The routine may change
     289                                ; R0-R4.
     290                                ; ---------------------------------------------------------------------
     291                                
     292 002102 012704  003414          WALK:	MOV	#BLKTAB,R4
     293 002106 020467  003412'         1$:	CMP	R4,BLKTOP
     294 002112 103043                  	BHIS	9$
     295 002114 012401                  	MOV	(R4)+,R1	; the block's start
     296 002116 012403                  	MOV	(R4)+,R3	; and its end
     297 002120 020167  003372'         	CMP	R1,PROT
     298 002124 103002                  	BHIS	2$
     299 002126 016701  003372'         	MOV	PROT,R1		; not over this program
     300 002132 020103                  2$:	CMP	R1,R3
     301 002134 103364                  	BHIS	1$		; nothing of this block is left to test
     302 002136 010302                  3$:	MOV	R3,R2
     303 002140 160102                  	SUB	R1,R2		; what is left of it
     304 002142 020227  000200          	CMP	R2,#CHUNK
     305 002146 101402                  	BLOS	4$
     306 002150 012702  000200          	MOV	#CHUNK,R2	; no more than fits in the window
     307 002154 010246                  4$:	MOV	R2,-(SP)
     308 002156 010146                  	MOV	R1,-(SP)
     309 002160 010346                  	MOV	R3,-(SP)
     310 002162 010446                  	MOV	R4,-(SP)
     311 002164 004767  002534'         	JSR	PC,MAP
     312 002170 006302                  	ASL	R2		; 64-byte blocks to words: times 32
     313 002172 006302                  	ASL	R2
     314 002174 006302                  	ASL	R2
     315 002176 006302                  	ASL	R2
     316 002200 006302                  	ASL	R2
     317 002202 004715                  	JSR	PC,(R5)
     318 002204 012604                  	MOV	(SP)+,R4
     319 002206 012603                  	MOV	(SP)+,R3
     320 002210 012601                  	MOV	(SP)+,R1
     321 002212 062601                  	ADD	(SP)+,R1	; the next stretch
     322 002214 020103                  	CMP	R1,R3
     323 002216 103747                  	BLO	3$
     324 002220 000732                  	BR	1$
     325 002222 000207                  9$:	RTS	PC
     326                                
     327                                ; FILL - write the test's values over one stretch.
     328 002224 004777  003374'         FILL:	JSR	PC,@STFN
     329 002230 010320                  1$:	MOV	R3,(R0)+
     330 002232 004777  003376'         	JSR	PC,@NXFN
     331 002236 005302                  	DEC	R2
     332 002240 001373                  	BNE	1$
     333 002242 000207                  	RTS	PC
     334                                
     335                                ; CHECK - read one stretch back and report every word that differs.
     336 002244 004777  003374'         CHECK:	JSR	PC,@STFN
     337 002250 012004                  1$:	MOV	(R0)+,R4
     338 002252 020403                  	CMP	R4,R3
     339 002254 001005                  	BNE	3$
     340 002256 004777  003376'         2$:	JSR	PC,@NXFN
     341 002262 005302                  	DEC	R2
     342 002264 001371                  	BNE	1$
     343 002266 000207                  	RTS	PC
     344 002270 004767  002276'         3$:	JSR	PC,BAD
     345 002274 000770                  	BR	2$
     346                                
     347                                ; BAD - count a bad word and, if few enough have been shown, show it.
     348                                ; R0 = just past it, R1 = the stretch's first 64-byte block,
     349                                ; R3 = what was written, R4 = what was read.  Keeps all registers.
     350 002276 005267  003404'         BAD:	INC	ERRCNT		; both counts stop at 65535 rather than
     351 002302 001002                  	BNE	1$		; going round to 0
     352 002304 005367  003404'         	DEC	ERRCNT
     353 002310 005267  003402'         1$:	INC	PERRS
     354 002314 001002                  	BNE	2$
     355 002316 005367  003402'         	DEC	PERRS
     356 002322 026727  003402' 000012  2$:	CMP	PERRS,#MAXERR
     357 002330 101401                  	BLOS	3$
     358 002332 000207                  	RTS	PC
     359 002334 010046                  3$:	MOV	R0,-(SP)
     360 002336 010146                  	MOV	R1,-(SP)
     361 002340 010246                  	MOV	R2,-(SP)
     362 002342 010002                  	MOV	R0,R2
     363 002344 004767  002534'         	JSR	PC,MAP		; R0 = where the stretch starts
     364 002350 160002                  	SUB	R0,R2
     365 002352 162702  000002          	SUB	#2,R2		; the bad word's offset in the stretch
     366 002356 010200                  	MOV	R2,R0
     367 002360 004767  002672'         	JSR	PC,SHR6
     368 002364 060001                  	ADD	R0,R1		; its 64-byte block
     369 002366 042702  177700          	BIC	#177700,R2	; and where in that
     370 002372 005767  003406'         	TST	BOL
     371 002376 001002                  	BNE	4$
     372 002400 004767  003322'         	JSR	PC,CRLF		; off the line of test names
     373 002404 012700  004222          4$:	MOV	#MSGBAD,R0
     374 002410 004767  003344'         	JSR	PC,PUTS
     375 002414 010100                  	MOV	R1,R0
     376 002416 010201                  	MOV	R2,R1
     377 002420 004767  003050'         	JSR	PC,PUTPA
     378 002424 012700  004241          	MOV	#MSGWR,R0
     379 002430 004767  003344'         	JSR	PC,PUTS
     380 002434 010300                  	MOV	R3,R0
     381 002436 004767  003116'         	JSR	PC,PUTO6
     382 002442 012700  004252          	MOV	#MSGRD,R0
     383 002446 004767  003344'         	JSR	PC,PUTS
     384 002452 010400                  	MOV	R4,R0
     385 002454 004767  003116'         	JSR	PC,PUTO6
     386 002460 012700  004262          	MOV	#MSGBIT,R0
     387 002464 004767  003344'         	JSR	PC,PUTS
     388 002470 010300                  	MOV	R3,R0		; the bits that differ, without XOR:
