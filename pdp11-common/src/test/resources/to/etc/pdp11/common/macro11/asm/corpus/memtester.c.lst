     403                                ; ---------------------------------------------------------------------
     404                                ; Addressing
     405                                ; ---------------------------------------------------------------------
     406                                
     407                                ; MAP - R0 = a virtual address for the 64-byte block R1, valid for the
     408                                ; 8 KB from there.  With memory management that is the window, moved
     409                                ; onto it; without, the address is simply the block number times 64.
     410 002534 005767  003366'         MAP:	TST	MODE
     411 002540 001405                  	BEQ	1$
     412 002542 010137  172354          	MOV	R1,@#KISA6
