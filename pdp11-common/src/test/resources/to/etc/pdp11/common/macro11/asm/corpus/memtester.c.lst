     474                                
     475                                ; SHOBLK - print the block from R1 to R2 (64-byte blocks, R2 just past
     476                                ; its end) as "  first - last  size KB".  Uses R0-R2.
     477 002740 012700  004061          SHOBLK:	MOV	#MSGIND,R0
