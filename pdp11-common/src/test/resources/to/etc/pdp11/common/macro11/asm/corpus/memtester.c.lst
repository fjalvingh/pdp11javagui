     197                                ; Test it, for ever
     198                                ; ---------------------------------------------------------------------
     199                                
     200 001530 005067  003400'         	CLR	PASSNO
     201 001534 005067  003404'         	CLR	ERRCNT
     202 001540 005267  003400'         PASS:	INC	PASSNO
     203 001544 005067  003402'         	CLR	PERRS
     204 001550 012700  004171          	MOV	#MSGPAS,R0
     205 001554 004767  003344'         	JSR	PC,PUTS
