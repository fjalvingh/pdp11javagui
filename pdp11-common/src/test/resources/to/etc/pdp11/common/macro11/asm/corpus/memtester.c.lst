       1                                	.TITLE	MEMTESTER - MEMORY SIZER AND TESTER FOR A BARE PDP-11
       2                                ;
       3                                ; Finds where memory is installed, reports each block by address and
       4                                ; size, and then tests all of it, pass after pass, until you stop it
       5                                ; with the HALT switch.  No operating system is needed.
       6                                ;
       7                                ; Runs on anything from an 11/05 up: it uses only the basic instruction
       8                                ; set (no SOB, XOR, MUL or DIV) and polls the console DL11 at 177560.
       9                                ;
      10                                ; Load it, then start at 1000. On an M9312 console:  L 1000  then  S
      11                                ;
      12                                ; How much memory it can see depends on the machine:
      13                                ;
      14                                ;  - without memory management, the 28K words below the I/O page at
      15                                ;    160000 - all an 11/05 or 11/03 can address;
      16                                ;  - with memory management, everything below the I/O page: 760000 on an
      17                                ;    18-bit machine, 17760000 on a 22-bit one (11/23, 11/24, 11/44, 11/70,
      18                                ;    11/73 and up).  The program runs in kernel mode with pages 0-5
      19                                ;    mapped onto themselves, and slides page 6 (140000-157777) over
      20                                ;    physical memory 8 KB at a time to reach the rest.
      21                                ;
      22                                ; FINDING THE MEMORY.  Every 1 KB it reads one word.  If nothing answers,
      23                                ; the bus times out and traps to 4; the trap handler sets the carry and
      24                                ; returns, so a probe is just "TST (R0)" followed by "BCS".
      25                                ;
      26                                ; Before that it checks that the high address lines are really there.  A
      27                                ; 22-bit processor in an 18-bit backplane, or an 18-bit one in a 16-bit
      28                                ; Q-bus, sees its low memory again at every multiple of 256 KB or 64 KB,
      29                                ; and would report that one board many times over.  So for each address
      30                                ; bit from 16 up it writes two patterns to a word of this program and
      31                                ; reads the same word with that bit set; if both come back, the bit is
      32                                ; not connected and the search stops below it.
      33                                ;
      34                                ; TESTING IT.  Each pass fills all of the memory with a pattern and then
      35                                ; reads all of it back, for five patterns:
      36                                ;
      37                                ;  ADDRESS  each word holds its own word address, modulo 177777.  The
      38                                ;	    residue keeps changing above 64K words, so a dead address
      39                                ;	    line - two addresses landing on one word - shows up wherever
      40                                ;	    it is.  It is made by adding 1 in one's complement (ADD #1 and
      41                                ;	    ADC), and the first value of a stretch is its 64-byte block
      42                                ;	    number rotated left five places, which is the same thing.
      43                                ;  INVERSE  the complement of that, so every bit is tried both ways.
      44                                ;  ZEROS, ONES, CHECKER (125252 and 052525 in turn).
      45                                ;
      46                                ; Each bad word is reported with its address, what was written, what was
      47                                ; read and which bits differ - the last is what points at a stuck data
      48                                ; line or a dead chip.  Only the first ten are shown in each pass; all
      49                                ; are counted.  The memory below the end of this program, which holds the
      50                                ; vectors, the stack and the program itself, is not tested.
      51                                ;
      52                                ; If the machine has a cache, bits 2 and 3 of the cache control register
      53                                ; at 177746 are set to force misses (11/70, 11/44, the J-11), so that the
      54                                ; reads below come from memory and not from the cache.
      55                                
      56 177564                         TPS	= 177564		; console printer status: bit 7 = ready to print
      57 177566                         TPB	= 177566		; console printer buffer
      58                                
      59 177572                         MMR0	= 177572		; memory management register 0: bit 0 = on
      60 172516                         MMR3	= 172516		; memory management register 3: bit 4 = 22-bit
      61 172300                         KISD0	= 172300		; kernel page descriptor registers 0-7
      62 172340                         KISA0	= 172340		; kernel page address registers 0-7
      63 172354                         KISA6	= KISA0+14		; the one for the window
      64 177746                         CCR	= 177746		; cache control register
      65                                
      66 140000                         WINDOW	= 140000		; where page 6 starts: the sliding window
      67 000200                         CHUNK	= 200			; 64-byte blocks in the window: 8 KB
      68 000020                         STEP	= 20			; 64-byte blocks between probes: 1 KB
      69 000024                         MAXBLK	= 20.			; most memory blocks it keeps track of
      70 000012                         MAXERR	= 10.			; most bad words shown in one pass
      71                                
      72 000040                         SPACE	= 40
      73                                
      74                                	.ASECT
      75 001000                         	.=1000
      76                                
      77 001000 012706  001000          START:	MOV	#START,SP	; stack grows down from 1000
      78 001004 012746  000340          	MOV	#340,-(SP)	; priority 7, so no interrupt gets in - the
      79 001010 012746  001016          	MOV	#10$,-(SP)	; 11/03's line clock has no enable bit.  RTI
      80 001014 000002                  	RTI			; sets the PS on every model; MTPS does not
      81 001016 012737  002730  000004  10$:	MOV	#BUSERR,@#4	; bus time-out: comes back with the carry set
      82 001024 012737  000340  000006  	MOV	#340,@#6
      83 001032 012700  003554          	MOV	#MSGHDR,R0
      84 001036 004767  003344'         	JSR	PC,PUTS
      85                                
      86                                ; ---------------------------------------------------------------------
      87                                ; How are addresses made?
      88                                ; ---------------------------------------------------------------------
      89                                
      90 001042 005067  003366'         	CLR	MODE
      91 001046 012767  001600  003370' 	MOV	#1600,LIMIT	; 160000 in 64-byte blocks
      92 001054 005737  177572          	TST	@#MMR0
      93 001060 103456                  	BCS	3$		; no memory management
      94 001062 005037  177572          	CLR	@#MMR0		; off while it is set up; a restart may find it on
      95                                
      96 001066 012700  172340          	MOV	#KISA0,R0	; pages 0-6 onto physical 0-157777
      97 001072 012701  172300          	MOV	#KISD0,R1
      98 001076 005002                  	CLR	R2
      99 001100 010220                  1$:	MOV	R2,(R0)+
     100 001102 012721  077406          	MOV	#77406,(R1)+	; 8 KB, read and write
     101 001106 062702  000200          	ADD	#200,R2
     102 001112 020027  172356          	CMP	R0,#KISA6+2
     103 001116 103770                  	BLO	1$
     104 001120 012711  077406          	MOV	#77406,(R1)	; page 7: the I/O page
     105 001124 012710  007600          	MOV	#7600,(R0)
     106 001130 012767  000001  003366' 	MOV	#1,MODE
     107 001136 012767  007600  003370' 	MOV	#7600,LIMIT	; 760000
     108                                
     109 001144 005737  172516          	TST	@#MMR3
     110 001150 103417                  	BCS	2$		; no MMR3: 18-bit (11/34, 11/40)
     111 001152 012737  000020  172516  	MOV	#20,@#MMR3	; ask for 22-bit addresses
     112 001160 032737  000020  172516  	BIT	#20,@#MMR3
     113 001166 001410                  	BEQ	2$		; it did not take: 18-bit (11/45, 11/55)
     114 001170 012710  177600          	MOV	#177600,(R0)	; page 7 to the 22-bit I/O page
     115 001174 012767  000002  003366' 	MOV	#2,MODE
     116 001202 012767  177600  003370' 	MOV	#177600,LIMIT	; 17760000
     117 001210 012737  000001  177572  2$:	MOV	#1,@#MMR0	; memory management on
     118                                
     119 001216 005737  177746          3$:	TST	@#CCR
     120 001222 103403                  	BCS	4$		; no cache
     121 001224 052737  000014  177746  	BIS	#14,@#CCR	; force misses: test the memory, not the cache
     122                                4$:
     123                                
     124                                ; ---------------------------------------------------------------------
     125                                ; Are the high address lines connected?
     126                                ; ---------------------------------------------------------------------
     127                                
     128 001232 005767  003366'         FOLDCK:	TST	MODE
     129 001236 001415                  	BEQ	7$		; 16 bits: nothing to check
     130 001240 012701  002000          	MOV	#2000,R1	; 200000, address bit 16, in 64-byte blocks
     131 001244 020167  003370'         5$:	CMP	R1,LIMIT
     132 001250 103010                  	BHIS	7$
     133 001252 004767  002574'         	JSR	PC,FOLDS
     134 001256 103403                  	BCS	6$
     135 001260 006301                  	ASL	R1		; the next address bit
     136 001262 103370                  	BCC	5$
     137 001264 000402                  	BR	7$
     138 001266 010167  003370'         6$:	MOV	R1,LIMIT	; look no higher than the first one missing
     139                                
     140 001272 016700  003366'         7$:	MOV	MODE,R0
     141 001276 006300                  	ASL	R0
     142 001300 016000  003546          	MOV	MODMSG(R0),R0
     143 001304 004767  003344'         	JSR	PC,PUTS
     144 001310 016700  003370'         	MOV	LIMIT,R0
     145 001314 005001                  	CLR	R1
     146 001316 004767  003050'         	JSR	PC,PUTPA
     147 001322 004767  003322'         	JSR	PC,CRLF
     148                                
     149                                ; ---------------------------------------------------------------------
     150                                ; Find the memory: one probe every 1 KB, contiguous answers make a block
     151                                ; ---------------------------------------------------------------------
     152                                
     153 001326 012704  003414          SIZE:	MOV	#BLKTAB,R4	; next free entry
     154 001332 012705  177777          	MOV	#-1,R5		; start of the block being found, -1 if none
     155 001336 005001                  	CLR	R1
     156 001340 020167  003370'         1$:	CMP	R1,LIMIT
     157 001344 103021                  	BHIS	4$
     158 001346 004767  002534'         	JSR	PC,MAP
     159 001352 005710                  	TST	(R0)
     160 001354 103405                  	BCS	2$		; nothing there
     161 001356 020527  177777          	CMP	R5,#-1
     162 001362 001007                  	BNE	3$
     163 001364 010105                  	MOV	R1,R5		; a block starts here
     164 001366 000405                  	BR	3$
     165 001370 020527  177777          2$:	CMP	R5,#-1
     166 001374 001402                  	BEQ	3$
     167 001376 004767  002710'         	JSR	PC,ADDBLK	; and ends here
     168 001402 062701  000020          3$:	ADD	#STEP,R1
     169 001406 000754                  	BR	1$
     170 001410 020527  177777          4$:	CMP	R5,#-1
     171 001414 001402                  	BEQ	5$
     172 001416 004767  002710'         	JSR	PC,ADDBLK	; runs up to the limit
     173 001422 010467  003412'         5$:	MOV	R4,BLKTOP
     174                                
     175 001426 012700  004041          	MOV	#MSGFND,R0
     176 001432 004767  003344'         	JSR	PC,PUTS
     177 001436 012704  003414          	MOV	#BLKTAB,R4
     178 001442 020467  003412'         6$:	CMP	R4,BLKTOP
     179 001446 103005                  	BHIS	7$
     180 001450 012401                  	MOV	(R4)+,R1
     181 001452 012402                  	MOV	(R4)+,R2
     182 001454 004767  002740'         	JSR	PC,SHOBLK
     183 001460 000770                  	BR	6$
     184                                
     185 001462 012700  004435          7$:	MOV	#PRGEND+77,R0	; the first 64-byte block clear of this program
     186 001466 004767  002672'         	JSR	PC,SHR6
     187 001472 010067  003372'         	MOV	R0,PROT
     188 001476 012700  004076          	MOV	#MSGTST,R0
     189 001502 004767  003344'         	JSR	PC,PUTS
     190 001506 016700  003372'         	MOV	PROT,R0
     191 001512 005001                  	CLR	R1
     192 001514 004767  003050'         	JSR	PC,PUTPA
     193 001520 012700  004126          	MOV	#MSGTS2,R0
     194 001524 004767  003344'         	JSR	PC,PUTS
