     444 002662 000261                  	SEC			; both followed: it is the same word
     445 002664 000207                  	RTS	PC
     446 002666 000241                  2$:	CLC
     447 002670 000207                  	RTS	PC
     448                                
     449                                ; SHR6 - shift R0, which must be positive, right six places.
     450 002672 006200                  SHR6:	ASR	R0
     451 002674 006200                  	ASR	R0
     452 002676 006200                  	ASR	R0
     453 002700 006200                  	ASR	R0
     454 002702 006200                  	ASR	R0
     455 002704 006200                  	ASR	R0
     456 002706 000207                  	RTS	PC
     457                                
     458                                ; ADDBLK - add the block from R5 to R1 (64-byte blocks) to the table
     459                                ; at R4, if it has room, and set R5 to -1.
     460 002710 020427  003534          ADDBLK:	CMP	R4,#BLKTAB+<MAXBLK*4>
     461 002714 103002                  	BHIS	1$
