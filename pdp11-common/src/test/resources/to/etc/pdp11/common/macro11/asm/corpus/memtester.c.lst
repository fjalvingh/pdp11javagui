     416 002556 006300                  	ASL	R0
     417 002560 006300                  	ASL	R0
     418 002562 006300                  	ASL	R0
     419 002564 006300                  	ASL	R0
     420 002566 006300                  	ASL	R0
     421 002570 006300                  	ASL	R0
     422 002572 000207                  	RTS	PC
     423                                
     424                                ; FOLDS - is the address bit worth R1 64-byte blocks not connected?
     425                                ; Sets the carry if the word FOLD reads back at its own address plus
     426                                ; that.  Uses R0 and R2.
     427 002574 010146                  FOLDS:	MOV	R1,-(SP)
     428 002576 012700  003410          	MOV	#FOLD,R0	; this program's own addresses are physical
     429 002602 010002                  	MOV	R0,R2
     430 002604 042702  177700          	BIC	#177700,R2	; its place in its 64-byte block
     431 002610 004767  002672'         	JSR	PC,SHR6
     432 002614 060001                  	ADD	R0,R1
     433 002616 004767  002534'         	JSR	PC,MAP
     434 002622 060002                  	ADD	R0,R2		; R2 = the same word with the bit set
     435 002624 012601                  	MOV	(SP)+,R1
     436 002626 005712                  	TST	(R2)
     437 002630 103416                  	BCS	2$		; no memory there at all
     438 002632 012767  125252  003410' 	MOV	#125252,FOLD
     439 002640 021227  125252          	CMP	(R2),#125252
     440 002644 001010                  	BNE	2$
     441 002646 012767  052525  003410' 	MOV	#052525,FOLD
     442 002654 021227  052525          	CMP	(R2),#052525
