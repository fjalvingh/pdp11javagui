<?xml version="1.0" encoding="UTF-8"?>
<!--
    The Tomcat 11 instance for https://tools.etc.to/ on pigalle.etc.to: /env/tools/conf/server.xml.

    Set up like the DomUI demo's instance beside it (/env/demo), with its own ports - 8088 for
    HTTP, 8188 for shutdown - and two differences, both what the demo's Apache config says it
    intends: the connector listens on the loopback address only, since Apache is the one thing
    that should talk to it, and the RemoteIpValve turns Apache's X-Forwarded-Proto and
    X-Forwarded-For back into a secure request from the real client.
-->
<Server port="8188" shutdown="SHUTDOWN">
  <Listener className="org.apache.catalina.startup.VersionLoggerListener" />
  <Listener className="org.apache.catalina.core.AprLifecycleListener" SSLEngine="on" />
  <Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener" />
  <Listener className="org.apache.catalina.mbeans.GlobalResourcesLifecycleListener" />
  <Listener className="org.apache.catalina.core.ThreadLocalLeakPreventionListener" />

  <Service name="Catalina">
    <Connector port="8088" address="127.0.0.1" protocol="HTTP/1.1"
               URIEncoding="UTF-8"
               connectionTimeout="20000" />

    <Engine name="Catalina" defaultHost="localhost">
      <Valve className="org.apache.catalina.valves.RemoteIpValve"
             remoteIpHeader="X-Forwarded-For"
             protocolHeader="X-Forwarded-Proto" />

      <Host name="localhost" appBase="webapps"
            unpackWARs="true" autoDeploy="false">
        <!-- requestAttributesEnabled: log the client and scheme the RemoteIpValve found. -->
        <Valve className="org.apache.catalina.valves.AccessLogValve" directory="logs"
               requestAttributesEnabled="true"
               prefix="localhost_access_log" suffix=".txt"
               pattern="%h %l %u %t &quot;%r&quot; %s %b" />
      </Host>
    </Engine>
  </Service>
</Server>
