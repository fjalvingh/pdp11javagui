<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>to.etc.pdp11</groupId>
        <artifactId>java11gui</artifactId>
        <version>1.0-SNAPSHOT</version>
    </parent>

    <artifactId>pdp11-app</artifactId>
    <name>pdp11-app</name>
    <description>
        main(), packaging and the data resources: machine descriptions and MACRO-11 drivers.
    </description>

    <dependencies>
        <dependency>
            <groupId>to.etc.pdp11</groupId>
            <artifactId>pdp11-ui</artifactId>
        </dependency>
    </dependencies>

    <build>
        <finalName>pdp11gui</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>${main.class}</mainClass>
                                    <!--
                                        So the jar can say which release it is: AppVersion reads
                                        this back, the About box and the log show it, and the
                                        release workflow asserts it matches the tag before it
                                        uploads anything. Set here rather than left to the jar
                                        plugin's default entries, which reach the shaded manifest
                                        only because the project's own jar happens to be the first
                                        one shade reads.
                                    -->
                                    <manifestEntries>
                                        <Implementation-Title>PDP11GUI</Implementation-Title>
                                        <Implementation-Version>${project.version}</Implementation-Version>
                                        <Implementation-Vendor>etc.to</Implementation-Vendor>
                                    </manifestEntries>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                        <exclude>module-info.class</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <configuration>
                    <mainClass>${main.class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
